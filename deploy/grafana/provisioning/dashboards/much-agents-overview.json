{
  "uid": "much-agents-overview",
  "title": "Much Agents Overview",
  "tags": ["much-agents"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API 5xx rate (5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(much_agents_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(much_agents_http_requests_total[5m])), 1)"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Readiness components",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "min(much_agents_ready_checks)"
        }
      ],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "unit": "none" } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "LLM cost last 24h (CNY)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(much_agents_llm_cost_cny_total[24h]))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyCNY" } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Runs last 24h",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(much_agents_runs_total[24h]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Queue depth",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "much_agents_queue_depth"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "LLM calls by status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(much_agents_llm_calls_total[1h]))"
        }
      ]
    }
  ]
}
