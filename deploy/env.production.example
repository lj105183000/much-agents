# ---------------------------------------------------------------------------
# Much Agents production Compose environment
#
#   1. cp deploy/env.production.example deploy/env.production
#   2. Replace every CHANGE_ME value. Use alphanumeric passwords so they can be
#      embedded in REDIS_URL/DATABASE_URL without percent-encoding.
#   3. chmod 600 deploy/env.production
#   4. ./deploy/nginx/generate-self-signed.sh <host-or-ip>   (or install real certs)
#   5. docker compose -f docker-compose.prod.yml up -d
#
# The file is gitignored. Never commit real credentials.
# ---------------------------------------------------------------------------

ENVIRONMENT=production
TZ=Asia/Shanghai
LOG_LEVEL=INFO

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8001
DOCS_ENABLED=false
CORS_ORIGINS=https://much-agents.internal
TRUSTED_PROXIES=*
MAX_UPLOAD_MB=200
MAX_PDF_PAGES=200
API_JOB_WORKERS=1
READINESS_CACHE_SECONDS=5
UPLOAD_DIR=/app/upload
PARSED_DIR=/app/upload/parsed
BIDS_DIR=/app/upload/bids

# --- Authentication / RBAC -------------------------------------------------
AUTH_ENABLED=true
AUTH_SESSION_TTL_HOURS=12
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOCKOUT_MINUTES=15
AUTH_HASH_CONCURRENCY=2
AUTH_LOGIN_IP_MAX_FAILURES=20
AUTH_LOGIN_IP_WINDOW_SECONDS=300
# Required by the production fail-fast check. Generate with: openssl rand -hex 32
MCP_API_TOKEN=CHANGE_ME_MCP_API_SERVICE_TOKEN

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=much_agents
POSTGRES_DB=much_agents
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql+asyncpg://much_agents:CHANGE_ME_DB_PASSWORD@postgres:5432/much_agents
DB_AUTO_MIGRATE=false

# --- Redis / Celery --------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
TASK_BACKEND=celery
CELERY_WORKER_POOL=prefork
CELERY_SOFT_TIME_LIMIT_SECONDS=3300
CELERY_TIME_LIMIT_SECONDS=3600
JOB_TTL_SECONDS=86400

# --- Object storage --------------------------------------------------------
STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_BUCKET=much-agents
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_ROOT_USER=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_SECRET_KEY
MINIO_TIMEOUT_SECONDS=30

# --- Vector store ----------------------------------------------------------
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=bidding_documents

# --- Bid generation --------------------------------------------------------
BID_RUN_MAX_ATTEMPTS=2
BID_RUN_STALE_SECONDS=900
BID_RETRIEVAL_TOP_K=6
BID_MAX_TOKENS=8192
BID_MAX_REVIEW_REVISIONS=1
BID_LLM_CONCURRENCY=2
BID_USE_CHROMA=true
BID_FIGURES_ENABLED=true
BID_FIGURES_MAX=4
BID_FIGURES_USE_LLM=true
BID_FIGURES_FONT=/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc
BID_FIGURES_EXTERNAL=false

# --- Model providers (features degrade when unset) -------------------------
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
MINERU_API_KEY=
