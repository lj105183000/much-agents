# DeepSeek模型 - 获取API密钥：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# LLM 模型配置
LLM_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-flash

# 智谱模型 - 获取API密钥：https://bigmodel.cn/apikey/platform
ZHIPU_API_KEY=

# 嵌入模型配置
EMBEDDING_MODEL=embedding-3
# Chroma 向量库目录
# 启动命令：chroma run --path ./chroma_db
# 接口文档：http://localhost:8000/docs
CHROMA_DIR=./chroma_db

# 运行环境：development 或 production。production 会执行安全配置检查，
# 拒绝弱口令、开放 CORS、关闭认证等不安全组合（见 docs/deployment.md）。
ENVIRONMENT=development

# API服务配置
# 生产建议 127.0.0.1，由 Nginx 反代；start.bat 开发模式需 0.0.0.0 供容器内 Nginx 访问。
API_HOST=0.0.0.0
API_PORT=8001
# 生产设为 false；开发保留 /docs 便于调试
DOCS_ENABLED=true
# 只有来自这些地址的 X-Forwarded-For 才被信任；逗号分隔，* 表示信任任意直连代理
TRUSTED_PROXIES=
# /api/ready 依赖检查结果缓存秒数
READINESS_CACHE_SECONDS=5
# 单个 PDF 最大页数（MinerU 上限 200）
MAX_PDF_PAGES=200
# 本地数据根目录：local 模式为权威存储；minio 模式仅作工作缓存（对象以 MinIO 为准）
UPLOAD_DIR=./upload
MAX_UPLOAD_MB=200
# 后台解析线程数；默认 1 串行，避免同时占用 MinerU 配额
API_JOB_WORKERS=1
# 允许的来源，逗号分隔；* 兼容 Vite dev 与 Electron file://（Origin 为 null）
CORS_ORIGINS=*
# 认证与 RBAC：默认开启，需要 PostgreSQL 与已应用的 Alembic 迁移。
# 无数据库的纯本地开发可显式设为 false；此时所有请求按本地 admin 处理，切勿暴露到内网。
AUTH_ENABLED=true
AUTH_SESSION_TTL_HOURS=12
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOCKOUT_MINUTES=15
# Argon2 并发上限；过高会占满线程池，生产默认 2
AUTH_HASH_CONCURRENCY=2
# 单 IP 登录失败窗口限流：窗口内失败 N 次后短时拒绝
AUTH_LOGIN_IP_MAX_FAILURES=20
AUTH_LOGIN_IP_WINDOW_SECONDS=300
# MCP 服务端调用业务 API 的 service token；AUTH_ENABLED=true 时必须设置，
# 否则 MCP 代理调用会收到 401。与入站 MCP_HTTP_TOKEN 是两回事。
MCP_API_TOKEN=
# MCP 进程默认使用的项目 id；不设置时项目类工具返回 400
MCP_DEFAULT_PROJECT_ID=
# 任务后端：celery（默认，需要 Redis + worker）或 local（进程内线程，仅开发/测试）
TASK_BACKEND=celery
# Celery broker；留空则复用下方 REDIS_URL
CELERY_BROKER_URL=
# Windows 必须 solo 池；Linux 可改为 prefork 等
CELERY_WORKER_POOL=solo
# 任务 soft/hard 时间上限（秒）；soft 必须小于 hard
CELERY_SOFT_TIME_LIMIT_SECONDS=3300
CELERY_TIME_LIMIT_SECONDS=3600
# Redis 中任务记录 TTL（秒，每次写入刷新）
JOB_TTL_SECONDS=86400

# 投标文件编写（多 Agent）
BIDS_DIR=./upload/bids
# 0=生成全部 11 个施工组织设计 narrative；N>0 只生成前 N 个，其余保留占位
BID_MAX_SECTIONS=0
BID_RETRIEVAL_TOP_K=6
BID_MAX_EVIDENCE_CHARS=6000
BID_MAX_TOKENS=8192
BID_TEMPERATURE=0.2
BID_MAX_REVIEW_REVISIONS=1
BID_LLM_CONCURRENCY=2
BID_USE_CHROMA=true
BID_PROFILE_MAX_MB=5

# AI 配图（组装时自动生成并插入；失败只警告，不阻断组装）
BID_FIGURES_ENABLED=true
BID_FIGURES_MAX=4
BID_FIGURES_USE_LLM=true
# 留空自动探测系统中文字体（Windows msyh/simhei、Linux Noto CJK）
BID_FIGURES_FONT=
BID_FIGURES_WIDTH_PX=1800
BID_FIGURES_IMAGE_WIDTH_CM=15.5
BID_FIGURES_PAGE_ESTIMATE=0.5
# 外部绘图工具仅用于施工总平面/工艺流程图，默认关闭
BID_FIGURES_EXTERNAL=false

# MCP 服务端：把本地 API 暴露为 MCP 工具（API 需先启动）
MCP_API_BASE_URL=http://127.0.0.1:8001
# HTTP 传输默认只绑定回环；非回环必须设置 MCP_HTTP_TOKEN
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8765
MCP_HTTP_TOKEN=

# MCP 客户端：外部检索证据/企业资料库/外部绘图，默认关闭
# 复制 mcp_servers.example.json 为 mcp_servers.json 后填写真实服务
MCP_CLIENT_ENABLED=false
MCP_CLIENT_CONFIG=./mcp_servers.json
MCP_CLIENT_MAX_SERVERS=8
MCP_CLIENT_MAX_TOOLS=64
MCP_CLIENT_MAX_CHARS=4000
MCP_CLIENT_MAX_IMAGE_BYTES=8000000
MCP_CLIENT_MAX_IMAGE_DIMENSION=4000
MCP_CLIENT_TIMEOUT_SECONDS=30

# 对象存储：local（与旧版本一致，仅本地 upload/）或 minio（默认，MinIO 为准）
STORAGE_BACKEND=minio
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_BUCKET=much-agents
# 客户端凭据；start.bat 创建本地容器时也使用这两个值作为 root 账号
MINIO_ACCESS_KEY=much_agents
MINIO_SECRET_KEY=much_agents_dev
# 未设置 MINIO_ACCESS_KEY/SECRET_KEY 时客户端回退使用以下 root 凭据
MINIO_ROOT_USER=much_agents
MINIO_ROOT_PASSWORD=much_agents_dev
# start.bat 仅用于本地容器：控制台映射端口（API 端口由 MINIO_ENDPOINT 决定）
MINIO_CONSOLE_PORT=9001
MINIO_TIMEOUT_SECONDS=30

# PostgreSQL 数据库（Docker 容器 much-agents-postgres，映射 5433）
DATABASE_URL=postgresql+asyncpg://much_agents:much_agents_dev@localhost:5433/much_agents
# 启动时自动执行 Alembic upgrade head（Celery worker 不执行迁移）
DB_AUTO_MIGRATE=true
# 持久化投标 run：单节最大尝试次数与 stale 心跳阈值（秒）
BID_RUN_MAX_ATTEMPTS=2
BID_RUN_STALE_SECONDS=900
# Redis 缓存
REDIS_URL=redis://localhost:6379/0

# MinerU 模型配置 - 获取API密钥：https://mineru.net/apiManage/token
# API密钥有效期 90 天，过期后需要重新获取
# 文档：https://mineru.net/apiManage/docs
MINERU_MODE=cloud
MINERU_API_KEY=
# 精准解析批量 API（本地文件先申请签名 URL 再上传）
# 单文件限制 200MB / 200 页；超过 200 页会自动分片后同批解析
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_ENDPOINT=https://mineru.net/api/v4/extract/task
MINERU_MAX_PAGES_PER_FILE=200
MINERU_SPLIT_PAGES=200
MINERU_MAX_FILE_MB=200
MINERU_TIMEOUT=180
MINERU_MODEL_VERSION=vlm
MINERU_POLL_INTERVAL=5
MINERU_MAX_POLLS=360
MINERU_JOB_TIMEOUT=900

# 解析产物目录
PARSED_DIR=./upload/parsed

# DeepSeek 结构化抽取
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=120
DEEPSEEK_MAX_RETRIES=3
EXTRACTION_MAX_INPUT_CHARS=24000
EXTRACTION_MAX_TOKENS=8192
EXTRACTION_ENABLED=true

# 分块与 Chroma 入库
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=bidding_documents
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT=60
CHUNK_SIZE=700
CHUNK_OVERLAP=120
CHUNK_MIN_SIZE=120
# PyMuPDF 表格抽取默认关闭（水印/复杂版式容易污染）
PYMUPDF_TABLES=false
LOG_LEVEL=INFO
